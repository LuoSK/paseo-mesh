{
  "name": "paseo-mesh",
  "version": "0.1.4",
  "description": "Paseo plugin for cross-host agent orchestration: list, read, create and message agents on other Paseo daemons.",
  "license": "MIT",
  "author": "jtsang4",
  "homepage": "https://github.com/jtsang4/paseo-mesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtsang4/paseo-mesh.git"
  },
  "bugs": {
    "url": "https://github.com/jtsang4/paseo-mesh/issues"
  },
  "keywords": [
    "paseo",
    "paseo-plugin",
    "mcp",
    "agents",
    "orchestration"
  ],
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "npm-shrinkwrap.json",
    "index.client.tsx",
    "index.server.ts",
    "docs/images/",
    "bin/",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepack": "node scripts/pack-manifest.mjs strip",
    "postpack": "node scripts/pack-manifest.mjs restore",
    "check:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "@getpaseo/protocol": "^0.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@getpaseo/cli": "^0.11.2",
    "@getpaseo/plugin": "^0.11.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^5.104.2",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "bin": {
    "paseo-mesh": "bin/paseo-mesh.mjs"
  }
}
